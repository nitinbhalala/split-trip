<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application>
        <!-- Debug builds never report installs, so developer installs stay out
             of the panel (android/install-tracker). -->
        <meta-data
            android:name="install_tracker.enabled"
            android:value="false" />
        <!-- Debug builds send no Analytics (keeps ad_impression revenue clean). -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
    </application>
</manifest>
